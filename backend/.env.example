# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/manufacturing_erp
MONGODB_URI_TEST=mongodb://localhost:27017/manufacturing_erp_test

# JWT — generate strong random values for real environments, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@manufacturing-erp.local

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Company
COMPANY_NAME=Forge Flo Manufacturing
COMPANY_CODE=FFM

# Logging
LOG_LEVEL=info

# Security
BCRYPT_SALT_ROUNDS=10
COOKIE_SECRET=change-me-cookie-secret-min-16-chars
